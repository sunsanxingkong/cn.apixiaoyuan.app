<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ★★ 2026-10-04：放行 minSdk 高于本应用的依赖库（minSdk 33 → 24 改造）。

         背景：miuix-blur 声明 minSdk=33，而我们要支持到 Android 7（API 24）。
         清单合并器默认会因此报错；overrideLibrary 让它放行。

         ⚠️ 放行不等于“能跑”：miuix-blur 的类只在 SDK_INT >= 33 时才会被加载，
            低版本走 core/design/glass/low/ 里的自写管线（见 GlassBackdrop 分流）。
            低版本一旦误加载 miuix-blur 的类，会因缺类抛 NoClassDefFoundError，
            所以所有引用点都必须有 SDK_INT 守卫，靠 lint NewApi 与真机回归把关。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ===================== PK 后台挂机（2026-10-03 新增） =====================
         保活需要三件套，缺一不可：
           FOREGROUND_SERVICE + FOREGROUND_SERVICE_SPECIAL_USE → 前台服务本身
           POST_NOTIFICATIONS（API 33+ 运行时权限）           → 前台服务必须有可见通知
           SYSTEM_ALERT_WINDOW（特殊权限，需手动授予）        → 悬浮球（那只笔）

         ⚠️ 注释里**不能出现连续两个连字符**（XML 规范禁止，会让 manifest
            合并器报 MergeFailureException: Error parsing AndroidManifest.xml）。
            这里原先用了一排「减号」当分隔线，导致 CI 从 #149 起一路红 ——
            而本地 :app:compileDebugKotlin **不处理 manifest**，所以查不出来。
            分隔线请一律用「等号」。
         ======================================================================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReverseOldGuy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ReverseOldGuy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PK 后台挂机：前台服务（常驻通知 + 悬浮球）。
             foregroundServiceType 必须是 specialUse —— 它是「其它类」的兜底类型；
             同时要在 service 里再声明一次对应权限（Android 14 起的要求）。 -->
        <service
            android:name=".core.pk.host.PkAutoHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pk auto grind keepalive" />
        </service>
    </application>

</manifest>
