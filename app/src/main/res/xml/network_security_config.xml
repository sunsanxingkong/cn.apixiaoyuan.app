<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置（2026-10-03，为内置 node 新增）。

  ## 为什么需要

  PK 页面已换成 **pk-node 提供的本机 H5**：`http://127.0.0.1:8792/pk-h5/pk.html`。
  而 `targetSdk >= 28` 时 Android **默认禁止明文 HTTP**（`cleartextTrafficPermitted=false`），
  WebView 会直接拒绝加载这个 `http://` 页面（症状是白屏 + `net::ERR_CLEARTEXT_NOT_PERMITTED`）。

  ## 为什么不用 android:usesCleartextTraffic="true"

  那个开关是**全局**的，等于把整个 App 对任意域名的明文流量都放开 ——
  对一个要跟小猿业务域通信的 App 来说面太大。

  这里只对 **回环地址**开明文：流量不出设备、不经过任何网络，
  没有中间人风险（这也是 Android 官方对 localhost 场景的推荐做法）。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 内置 node 的服务地址 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>